pipeline{
    agent any
environment {
    GIT_REPO = 'https://github.com/nagababuvadlapudi5-sudo/python-automation-program.git'
}
 stages{
        stage('source'){
            steps{
                echo 'Cloning...'
                git clone:${GIT_REPO}
                
            }
        }
        stage('build'){
            steps{
                echo 'Building...'
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh 'sudo docker build -t python-automation-program .'
                    sh 'sudo docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD'
                    sh 'sudo docker push python-automation-program'
            }
        }
        stage('test'){
            steps{
                echo 'Testing...'
                sh 'sudo docker run python-automation-program python -m unittest discover tests'
            }
        }
        stage('deploy'){
            steps{
                echo 'Deploying...'
                sh 'sudo docker run -d -p 5000:5000 python-automation-program'
            }
        }   
    }
}
}
