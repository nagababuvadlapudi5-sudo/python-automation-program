pipeline {

```
agent any

options {
    skipDefaultCheckout(true)
    timeout(time: 30, unit: 'MINUTES')
}

environment {
    GIT_REPO = 'https://github.com/nagababuvadlapudi5-sudo/python-automation-program.git'
    IMAGE_REPO = 'python-automation-program'
    CONTAINER_NAME = 'python-automation-container'
}

stages {

    // STAGE 1: CHECKOUT
    stage('Checkout') {
        steps {
            echo 'Checking out GitHub repository...'

            git branch: 'main', url: "${GIT_REPO}"
        }
    }

    // STAGE 2: UNIT TESTING
    stage('Unit Testing') {
        steps {
            echo 'Running Python unit tests...'

            sh '''
                python3 -m unittest discover -s . -p "test_*.py" -v
            '''
        }
    }

    // STAGE 3: DOCKER BUILD
    stage('Docker Build') {
        steps {
            echo 'Building Docker image...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    docker build \
                        -t "$DOCKER_USERNAME/$IMAGE_REPO:latest" \
                        -t "$DOCKER_USERNAME/$IMAGE_REPO:$BUILD_NUMBER" .
                '''
            }
        }
    }

    // STAGE 4: DOCKER PUSH
    stage('Docker Push') {
        steps {
            echo 'Authenticating with Docker Hub and pushing image...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    set -e

                    trap 'docker logout >/dev/null 2>&1 || true' EXIT

                    echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" --password-stdin

                    docker push "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    docker push "$DOCKER_USERNAME/$IMAGE_REPO:$BUILD_NUMBER"
                '''
            }
        }
    }

    // STAGE 5: DEPLOY
    stage('Deploy') {
        steps {
            echo 'Deploying Docker container on EC2...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    set -e

                    echo "Pulling latest Docker image..."

                    echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" --password-stdin

                    docker pull "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    echo "Removing old container..."

                    docker rm -f "$CONTAINER_NAME" || true

                    echo "Starting new container..."

                    docker run -d \
                        --name "$CONTAINER_NAME" \
                        --restart unless-stopped \
                        -p 5000:5000 \
                        "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    echo "Checking container status..."

                    docker ps

                    echo "Checking port mapping..."

                    docker port "$CONTAINER_NAME"

                    echo "Checking application logs..."

                    docker logs --tail 20 "$CONTAINER_NAME"

                    docker logout
                '''
            }
        }
    }
}

post {
    success {
        echo 'CI/CD Pipeline completed successfully!'
        echo 'Application deployed on AWS EC2.'
    }

    failure {
        echo 'Pipeline failed. Check the console output.'
    }

    always {
        echo 'Pipeline execution finished.'
    }
}
```

}
