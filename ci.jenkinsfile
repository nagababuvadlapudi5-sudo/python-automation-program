pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/nagababuvadlapudi5-sudo/python-automation-program.git'
        IMAGE_NAME = 'YOUR_DOCKERHUB_USERNAME/python-automation-program:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Cloning repository...'
                git branch: 'main', url: "${GIT_REPO}"
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t "$IMAGE_NAME" .'
            }
        }

        stage('Docker Hub Login and Push') {
            steps {
                echo 'Logging in to Docker Hub...'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" |
                            docker login -u "$DOCKER_USERNAME" --password-stdin

                        docker push "$IMAGE_NAME"

                        docker logout
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh 'docker run --rm "$IMAGE_NAME" python -m unittest discover -s tests'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'

                sh '''
                    docker rm -f python-automation-container || true

                    docker run -d \
                        --name python-automation-container \
                        -p 5000:5000 \
                        "$IMAGE_NAME"
                '''
            }
        }
    }
}
