pipeline {
agent any

options {
    skipDefaultCheckout(true)
    timeout(time: 30, unit: 'MINUTES')
}

environment {
    GIT_REPO = 'https://github.com/nagababuvadlapudi5-sudo/python-automation-program.git'
    IMAGE_REPO = 'python-automation-program'
    CONTAINER_NAME = 'python-automation-container'
}

stages {

    stage('Checkout') {
        steps {
            echo 'Checking out source code...'

            git branch: 'main', url: "${GIT_REPO}"
        }
    }

    stage('Unit Testing') {
        steps {
            echo 'Installing dependencies and running Python tests...'

            sh '''
                docker run --rm \
                    -v "$WORKSPACE:/app" \
                    -w /app \
                    python:3.12-slim \
                    sh -c "pip install --no-cache-dir -r requirements.txt && python -m unittest discover -s . -p 'test_*.py' -v"
            '''
        }
    }

    stage('Docker Build') {
        steps {
            echo 'Building Docker image...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    docker build \
                        -t "$DOCKER_USERNAME/$IMAGE_REPO:latest" \
                        -t "$DOCKER_USERNAME/$IMAGE_REPO:$BUILD_NUMBER" .
                '''
            }
        }
    }

    stage('Docker Push') {
        steps {
            echo 'Pushing images to Docker Hub...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    set -e

                    trap 'docker logout >/dev/null 2>&1 || true' EXIT

                    echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" --password-stdin

                    docker push "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    docker push "$DOCKER_USERNAME/$IMAGE_REPO:$BUILD_NUMBER"
                '''
            }
        }
    }

    stage('Deploy') {
        steps {
            echo 'Deploying application on EC2...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    set -e

                    trap 'docker logout >/dev/null 2>&1 || true' EXIT

                    echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" --password-stdin

                    docker pull "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    docker rm -f "$CONTAINER_NAME" || true

                    docker run -d \
                        --name "$CONTAINER_NAME" \
                        --restart unless-stopped \
                        -p 5000:5000 \
                        "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    echo "Checking container status..."

                    docker ps

                    echo "Checking port mapping..."

                    docker port "$CONTAINER_NAME"

                    echo "Checking application logs..."

                    docker logs --tail 20 "$CONTAINER_NAME"
                '''
            }
        }
    }
}

post {
    success {
        echo 'CI/CD Pipeline completed successfully!'
        echo 'Application deployed successfully on EC2.'
    }

    failure {
        echo 'Pipeline failed. Check Console Output.'
    }

    always {
        echo 'Pipeline execution finished.'
    }
}

}
