pipeline {
agent any

options {
    skipDefaultCheckout(true)
    timeout(time: 30, unit: 'MINUTES')
}

environment {
    GIT_REPO = 'https://github.com/nagababuvadlapudi5-sudo/python-automation-program.git'
    IMAGE_REPO = 'python-automation-program'
    CONTAINER_NAME = 'python-automation-container'
}

stages {
    stage('Checkout') {
        steps {
            echo 'Checking out source code...'
            git branch: 'main', url: "${GIT_REPO}"
        }
    }

    stage('Unit Testing') {
        steps {
            echo 'Installing python dependencies...'
            sh '''
                python3 -m pip install --user -t requirements.txt
                
                echo "Running python unit tests......."
                python3 -m unittest discover -s . -p "test_*.py" -v
            '''
        }
    }

    stage('Docker Build') {
        steps {
            echo 'Building Docker image...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    docker build \
                        -t "$DOCKER_USERNAME/$IMAGE_REPO:latest" \
                        -t "$DOCKER_USERNAME/$IMAGE_REPO:$BUILD_NUMBER" .
                '''
            }
        }
    }

    stage('Docker Push') {
        steps {
            echo 'Pushing Docker image to Docker Hub...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    set -e
                    echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" --password-stdin

                    docker push "$DOCKER_USERNAME/$IMAGE_REPO:latest"
                    docker push "$DOCKER_USERNAME/$IMAGE_REPO:$BUILD_NUMBER"

                    docker logout
                '''
            }
        }
    }

    stage('Deploy') {
        steps {
            echo 'Deploying application on EC2...'

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {
                sh '''
                    set -e

                    echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" --password-stdin

                    docker pull "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    docker rm -f "$CONTAINER_NAME" || true

                    docker run -d \
                        --name "$CONTAINER_NAME" \
                        --restart unless-stopped \
                        -p 5000:5000 \
                        "$DOCKER_USERNAME/$IMAGE_REPO:latest"

                    docker ps
                    docker port "$CONTAINER_NAME"
                    docker logs --tail 20 "$CONTAINER_NAME"

                    docker logout
                '''
            }
        }
    }
}

post {
    success {
        echo 'CI/CD pipeline completed successfully!'
    }

    failure {
        echo 'CI/CD pipeline failed. Check console output.'
    }

    always {
        echo 'Pipeline execution finished.'
    }
}


}
