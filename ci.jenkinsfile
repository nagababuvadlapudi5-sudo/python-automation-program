```groovy
pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/nagababuvadlapudi5-sudo/python-automation-program.git'
        IMAGE_NAME = 'YOUR_DOCKERHUB_USERNAME/python-automation-program:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Cloning repository...'
                git url: "${GIT_REPO}"
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image...'
                sh 'sudo docker build -t "$IMAGE_NAME" .'
            }
        }

        stage('Docker Hub Login and Push') {
            steps {
                echo 'Logging in to Docker Hub...'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" |
                            sudo docker login -u "$DOCKER_USERNAME" --password-stdin

                        sudo docker push "$IMAGE_NAME"

                        sudo docker logout
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh 'sudo docker run --rm "$IMAGE_NAME" python -m unittest discover -s tests'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'

                sh '''
                    sudo docker rm -f python-automation-container || true

                    sudo docker run -d \
                        --name python-automation-container \
                        -p 5000:5000 \
                        "$IMAGE_NAME"
                '''
            }
        }
    }
}
```
